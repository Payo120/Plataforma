<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="336.0" prefWidth="289.0" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="me.edu.uam.registro.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Registro de usuario" textAlignment="CENTER">
        <font>
            <Font size="27.0" />
        </font>
    </Label>

    <Label text="Nombre completo:" />
    <TextField fx:id="txtNombre" promptText="Escriba su nombre" />

    <Label text="Usuario:" />
    <TextField fx:id="txtUsuario" promptText="Escriba su usuario" />

    <Label text="Contraseña:" />
    <PasswordField fx:id="txtPassword" promptText="Escriba su contraseña" />

    <Button mnemonicParsing="false" onAction="#onMostrarDatosClick" text="Mostrar Datos" textFill="#59cfc7" />

    <Label fx:id="lblResultado" prefHeight="40.0" prefWidth="247.0" text="Informacion pendiente" wrapText="true">
        <font>
            <Font size="13.0" />
        </font>
    </Label>
</VBox>