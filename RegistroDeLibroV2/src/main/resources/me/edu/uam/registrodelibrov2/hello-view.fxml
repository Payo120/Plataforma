<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="me.edu.uam.registrodelibrov2.HelloController"
            style="-fx-background-color: #f7f8fc;">

    <center>

        <!-- TARJETA PRINCIPAL -->
        <VBox spacing="0"
              maxWidth="900"
              style="-fx-background-color: white;
                     -fx-background-radius: 10;
                     -fx-border-color: #d9dce5;
                     -fx-border-radius: 10;
                     -fx-border-width: 1;">

            <padding>
                <Insets top="28"
                        right="35"
                        bottom="28"
                        left="35"/>
            </padding>

            <!-- ENCABEZADO -->
            <VBox spacing="6">

                <Label text="Registro de Libro"
                       style="-fx-text-fill: #202124;
                              -fx-font-weight: bold;">
                    <font>
                        <Font size="26"/>
                    </font>
                </Label>

                <Label text="Complete la información para agregar un nuevo libro al catálogo."
                       style="-fx-text-fill: #666666;">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>

            </VBox>

            <VBox prefHeight="25"/>

            <!-- FORMULARIO -->
            <GridPane hgap="20"
                      vgap="15">

                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints
                            minWidth="165"
                            prefWidth="165"/>

                    <javafx.scene.layout.ColumnConstraints
                            hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- TITULO -->
                <Label text="Título del libro:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #303030;"/>

                <TextField fx:id="tituloField"
                           promptText="Ingrese el título del libro"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"
                           prefHeight="42"
                           style="-fx-background-radius: 5;
                                  -fx-border-radius: 5;
                                  -fx-border-color: #d5d7dc;
                                  -fx-background-color: white;
                                  -fx-padding: 10;"/>


                <!-- AUTOR -->
                <Label text="Autor:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #303030;"/>

                <TextField fx:id="autorField"
                           promptText="Ingrese el nombre del autor"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"
                           prefHeight="42"
                           style="-fx-background-radius: 5;
                                  -fx-border-radius: 5;
                                  -fx-border-color: #d5d7dc;
                                  -fx-background-color: white;
                                  -fx-padding: 10;"/>


                <!-- ISBN -->
                <Label text="ISBN:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #303030;"/>

                <TextField fx:id="isbnField"
                           promptText="Ingrese el ISBN (ej. 978-612-123456-7)"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"
                           prefHeight="42"
                           style="-fx-background-radius: 5;
                                  -fx-border-radius: 5;
                                  -fx-border-color: #d5d7dc;
                                  -fx-background-color: white;
                                  -fx-padding: 10;"/>


                <!-- CATEGORIA -->
                <Label text="Categoría:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #303030;"/>

                <TextField fx:id="categoriaField"
                           promptText="Ingrese la categoría del libro"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"
                           prefHeight="42"
                           style="-fx-background-radius: 5;
                                  -fx-border-radius: 5;
                                  -fx-border-color: #d5d7dc;
                                  -fx-background-color: white;
                                  -fx-padding: 10;"/>


                <!-- PRECIO -->
                <Label text="Precio (USD):"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #303030;"/>

                <TextField fx:id="precioField"
                           promptText="Ingrese el precio del libro"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"
                           prefHeight="42"
                           style="-fx-background-radius: 5;
                                  -fx-border-radius: 5;
                                  -fx-border-color: #d5d7dc;
                                  -fx-background-color: white;
                                  -fx-padding: 10;"/>


                <!-- LINEA -->
                <Line startX="0"
                      endX="700"
                      stroke="#dddddd"
                      GridPane.columnIndex="0"
                      GridPane.columnSpan="2"
                      GridPane.rowIndex="5"/>


                <!-- CLAVE -->
                <Label text="Clave administrativa:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="6"
                       style="-fx-font-weight: bold;
                              -fx-text-fill: #303030;"/>

                <PasswordField fx:id="claveField"
                               promptText="Ingrese la clave para confirmar"
                               GridPane.columnIndex="1"
                               GridPane.rowIndex="6"
                               prefHeight="42"
                               style="-fx-background-radius: 5;
                                      -fx-border-radius: 5;
                                      -fx-border-color: #d5d7dc;
                                      -fx-background-color: white;
                                      -fx-padding: 10;"/>


                <!-- MENSAJE -->
                <Label text="Esta clave es necesaria para guardar el registro."
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="7"
                       style="-fx-text-fill: #666666;
                              -fx-font-size: 12px;"/>

            </GridPane>

            <VBox prefHeight="20"/>


            <!-- BOTONES -->
            <HBox alignment="CENTER_RIGHT"
                  spacing="12">

                <!-- LIMPIAR -->
                <Button text="Limpiar"
                        mnemonicParsing="false"
                        onAction="#limpiarFormulario"
                        prefWidth="95"
                        prefHeight="38"
                        style="-fx-background-color: white;
                               -fx-border-color: #d5d7dc;
                               -fx-border-radius: 5;
                               -fx-background-radius: 5;
                               -fx-text-fill: #444444;
                               -fx-font-weight: bold;"/>


                <!-- GUARDAR -->
                <Button text="Guardar Libro"
                        mnemonicParsing="false"
                        onAction="#guardarLibro"
                        prefWidth="130"
                        prefHeight="38"
                        style="-fx-background-color: #5746d9;
                               -fx-background-radius: 5;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>